# Copy to .env and fill in. .env is gitignored — never commit it.

# Stock footage — https://pixabay.com/api/docs/
PIXABAY_KEY=

# Background music — https://devportal.jamendo.com (free, "Client ID")
JAMENDO_CLIENT_ID=

# Script writer — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Buffer — https://publish.buffer.com → Settings → API
BUFFER_ACCESS_TOKEN=
BUFFER_CHANNEL_INSTAGRAM=
BUFFER_CHANNEL_TIKTOK=
BUFFER_CHANNEL_YOUTUBE=

# Where the rendered MP4s are hosted so Buffer can fetch them.
# A GitHub repo you own, plus a token with `contents: write` on it.
VIDEO_HOST_REPO=
GITHUB_TOKEN=

# Shown in the TikTok / YouTube call to action
PROFILE_LINK=https://focusflow-rose-one.vercel.app
